# LLM Provider (openrouter, openai, anthropic, google)
LLM_PROVIDER=openrouter

# OpenRouter API Key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Model to use via OpenRouter (vision-capable models work best)
# Options: openai/gpt-4o  |  anthropic/claude-3.5-sonnet  |  google/gemini-pro-1.5
LLM_MODEL=openai/gpt-4o

# API Keys for direct providers (only needed if NOT using OpenRouter)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=AIza-your-google-key-here

# Browser settings
HEADLESS=false

# Operator UI port
OPERATOR_PORT=6000

# Allowed domains for safety guardrail (comma-separated)
ALLOWED_DOMAINS=localhost:5001,localhost:5002

# BankDemo port
BANKDEMO_PORT=5001
